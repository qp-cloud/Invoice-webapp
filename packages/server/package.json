{
  "name": "@inventory/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:stress": "tsx src/scripts/stress-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "TEST_PG=1 vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.1",
    "@inventory/shared": "*",
    "fastify": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "form-data": "^4.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
