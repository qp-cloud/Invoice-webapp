[Unit]
Description=Inventory Management System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=windows-11-devp
WorkingDirectory=/mnt/e/Cluade/Invoice-webapp
# WEB_DIST_DIR is normally set by ./run.sh; systemd needs it explicit.
Environment=WEB_DIST_DIR=/mnt/e/Cluade/Invoice-webapp/packages/web/dist
ExecStart=/usr/bin/node --env-file=/mnt/e/Cluade/Invoice-webapp/.env /mnt/e/Cluade/Invoice-webapp/packages/server/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
