# Copy this file to `.env` and edit. Load it when starting the server, e.g.
#   node --env-file=.env packages/server/dist/index.js
# (or use ./run.sh which does that for you)

NODE_ENV=production
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Persistent database directory, relative to packages/server. BACK THIS UP.
# "memory" = throwaway in-memory (do not use for real data).
PGLITE_DATA_DIR=./data

# Owner unlock PIN. Blank = open (single local user, localhost only).
# Set a value to require the PIN before the app loads.
APP_PIN=

# Optional fixed secret for the unlock cookie. Defaults to a value derived
# from the PIN, which is fine for a single machine.
APP_SESSION_SECRET=

# Local encrypted backups (AES-256-GCM). CHANGE THE PASSPHRASE and keep it
# somewhere safe and separate — without it, backups cannot be restored.
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=CHANGE-ME-to-a-long-random-passphrase

# Serve the built web UI from the same server. Absolute path to packages/web/dist.
WEB_DIST_DIR=/absolute/path/to/inventory/packages/web/dist

# Optional: use a real PostgreSQL server instead of the embedded PGlite file store.
# When set, PGLITE_DATA_DIR is ignored.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/inventory
